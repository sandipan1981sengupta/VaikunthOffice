@model SetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set your password";
    var link = Model.Link;
    var welcome = link?.Purpose == PasswordLinkPurpose.Invite;
}
<partial name="~/Views/Account/_AuthHero.cshtml" />

<div class="vk-window-wrap">
    <div class="vk-window-orbs" aria-hidden="true"><span class="w1"></span><span class="w2"></span><span class="w3"></span></div>
    <form method="post" action="/account/set-password" class="vk-window glass" novalidate>
        @if (link is not { IsUsable: true })
        {
            <div class="vk-window-top">
                <div>
                    <div class="vk-eyebrow">Link not valid</div>
                    <h2>This link has run out</h2>
                    <p class="vk-window-sub">
                        @(link is null ? "We couldn't find this link." : link.UsedUtc is not null ? "It has already been used." : !link.IsActive || !link.TenantActive ? "This account is switched off. Ask your admin." : "It was only valid for a while.")
                        Ask for a new one below, or ask your admin to resend your invite.
                    </p>
                </div>
                <span class="vk-lock"><i class="fa fa-chain-broken" aria-hidden="true"></i></span>
            </div>
            <a class="vk-btn vk-btn-grad vk-signin" href="/account/forgot@(link is null ? "" : "?email=" + Uri.EscapeDataString(link.Email))">Get a new link <i class="fa fa-arrow-right"></i></a>
            <p class="vk-small-center"><a class="vk-link" href="/account/login">Back to sign in</a></p>
        }
        else
        {
            <div class="vk-window-top">
                <div>
                    <div class="vk-eyebrow">@(welcome ? "Welcome" : "Reset password")</div>
                    <h2>@(welcome ? $"Hello, {link.DisplayName.Split(' ')[0]}" : "Choose a new password")</h2>
                    <p class="vk-window-sub">@(welcome ? $"Set a password to start using Vaikunth Desk{(link.TenantName is null ? "" : $" at {link.TenantName}")}." : "Pick something you haven't used before.")</p>
                </div>
                <span class="vk-lock"><i class="fa fa-unlock-alt" aria-hidden="true"></i></span>
            </div>
            @Html.AntiForgeryToken()
            <input type="hidden" name="Token" value="@Model.Token" />
            <div asp-validation-summary="All" class="vk-form-error" role="alert"></div>
            <vk-input id="EmailShown" label="Your email" icon="envelope-o" value="@link.Email" />
            <vk-input id="Password" label="New password" is-password="true" mandatory="true" placeholder="At least 8 characters" autocomplete="new-password" autofocus="true" />
            <vk-input id="ConfirmPassword" label="New password again" is-password="true" mandatory="true" autocomplete="new-password" />
            <ul class="vk-pw-rules" id="pwRules">
                <li data-rule="len"><i class="fa fa-circle-o"></i> At least 8 characters</li>
                <li data-rule="match"><i class="fa fa-circle-o"></i> Both passwords match</li>
            </ul>
            <button type="submit" class="vk-btn vk-btn-grad vk-signin">@(welcome ? "Set password and continue" : "Save new password") <i class="fa fa-arrow-right"></i></button>
        }
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var shown = document.getElementById("EmailShown"); if (shown) { shown.readOnly = true; shown.removeAttribute("name"); }
            var a = document.getElementById("Password"), b = document.getElementById("ConfirmPassword"), rules = document.getElementById("pwRules");
            if (!a) return;
            function check() {
                var ok = { len: a.value.length >= 8, match: a.value.length > 0 && a.value === b.value };
                rules.querySelectorAll("li").forEach(function (li) {
                    var on = ok[li.getAttribute("data-rule")];
                    li.classList.toggle("ok", on);
                    li.querySelector("i").className = on ? "fa fa-check-circle" : "fa fa-circle-o";
                });
            }
            a.addEventListener("input", check); b.addEventListener("input", check);
        })();
    </script>
}

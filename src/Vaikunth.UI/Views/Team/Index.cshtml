@model TeamViewModel
@{
    ViewData["Title"] = "People";
    var c = Model.Company;
}
<section class="vk-admin-head">
    <div>
        <div class="vk-eyebrow"><i class="fa fa-building-o"></i> @User.TenantName()</div>
        <h1>People</h1>
        <p class="vk-muted">Add the people in your office. Each one gets an email with a link to set their own password.</p>
    </div>
    <button type="button" class="vk-btn vk-btn-grad" data-open-dialog="inviteDialog"><i class="fa fa-user-plus"></i> Add people</button>
</section>

@if (TempData["Ok"] is string ok) { <div class="vk-banner ok"><i class="fa fa-check-circle"></i> @ok</div> }
@if (TempData["Error"] is string err) { <div class="vk-banner err"><i class="fa fa-exclamation-circle"></i> @err</div> }
@if (!Model.EmailConfigured)
{
    <div class="vk-banner info"><i class="fa fa-flask"></i> Email isn't set up on this server yet, so emails go to the developer outbox instead of being sent.
        <a class="vk-link" href="/dev/outbox" target="_blank">Open the outbox</a></div>
}

@if (c is not null)
{
    <section class="vk-stats vk-stats-3">
        <vk-stat-card icon="id-card-o" label="Licenses used" value="@($"{c.ActiveUsers} of {c.MaxUsers}")" sub="@($"{Math.Max(0, c.MaxUsers - c.ActiveUsers)} free · {c.PlanName} plan")" tone="navy" />
        <vk-stat-card icon="envelope-o" label="Waiting to join" value="@(ViewData["InvitedCount"]?.ToString())" sub="invited, no password yet" tone="gold" />
        <vk-stat-card icon="database" label="Storage" value="@Sizes.Bytes(c.StorageUsedBytes)" sub="@($"of {Sizes.Bytes(c.StorageQuotaBytes)}")" tone="green" />
    </section>
}

<section class="vk-recent glass-soft">
    <div class="vk-recent-head">
        <h2>Everyone at @User.TenantName()</h2>
        <nav class="vk-chips">
            <a class="@(Model.Show == "all" ? "on" : "")" href="/team">All @ViewData["AllCount"]</a>
            <a class="@(Model.Show == "invited" ? "on" : "")" href="/team?show=invited">Invited @ViewData["InvitedCount"]</a>
            <a class="@(Model.Show == "off" ? "on" : "")" href="/team?show=off">Switched off @ViewData["OffCount"]</a>
        </nav>
    </div>
    <div class="vk-table-scroll">
    <table class="vk-files vk-clients">
        <thead><tr><th>Person</th><th>Department</th><th>Joined</th><th>Role</th><th>Status</th><th>Last sign-in</th><th>Added</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.People)
        {
            var me = p.UserId == Model.Me;
            <tr class="@(p.IsActive ? "" : "is-off")">
                <td>
                    <div class="vk-client">
                        <vk-avatar name="@p.DisplayName" tone="@p.AvatarTone" photo-url="@UserExtensions.PhotoUrl(p.UserId, p.PhotoVersion)" />
                        <span><b>@p.DisplayName @(me ? "(you)" : "")</b><small>@p.Email</small></span>
                    </div>
                </td>
                <td><span class="vk-cell-2"><b>@(p.Department ?? "—")</b><small>@p.JobTitle</small></span></td>
                <td class="vk-muted">@(p.JoiningDate?.ToString("d MMM yyyy") ?? "—")</td>
                <td>
                    @if (me)
                    {
                        <span class="vk-pill">Admin</span>
                    }
                    else
                    {
                        <form method="post" action="/team/role" class="vk-inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@p.UserId" /><input type="hidden" name="name" value="@p.DisplayName" />
                            <select name="role" class="vk-mini-select" onchange="this.form.submit()">
                                <option value="Member" selected="@(p.Role != AppRoles.TenantAdmin)">Member</option>
                                <option value="TenantAdmin" selected="@(p.Role == AppRoles.TenantAdmin)">Admin</option>
                            </select>
                        </form>
                    }
                </td>
                <td><span class="vk-state vk-state-@p.Status.ToLowerInvariant()">@(p.Status == "Invited" ? "Invited" : p.Status)</span></td>
                <td class="vk-muted">@(p.LastLoginUtc is DateTime l ? UserExtensions.Ago(l) : "Never")</td>
                <td class="vk-muted">@UserExtensions.Ago(p.CreatedUtc)@(p.InvitedByName is null ? "" : $" by {p.InvitedByName}")</td>
                <td class="vk-row-actions">
                    <button type="button" class="vk-btn vk-btn-light vk-btn-sm" data-edit-person title="Change name, department, job title or joining date"
                            data-id="@p.UserId" data-name="@p.DisplayName" data-email="@p.Email" data-dept="@p.Department" data-job="@p.JobTitle"
                            data-joined="@(p.JoiningDate?.ToString("yyyy-MM-dd"))"><i class="fa fa-pencil"></i> Edit</button>
                    @if (p.IsActive)
                    {
                        <form method="post" action="/team/resend" class="vk-inline-form">
                            @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@p.UserId" />
                            <button class="vk-btn vk-btn-light vk-btn-sm" type="submit" title="@(p.IsInvited ? "Send the invite email again" : "Email them a link to choose a new password")">
                                <i class="fa @(p.IsInvited ? "fa-paper-plane" : "fa-key")"></i> @(p.IsInvited ? "Resend invite" : "Reset password")
                            </button>
                        </form>
                    }
                    @if (!me)
                    {
                        <form method="post" action="/team/active" class="vk-inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@p.UserId" /><input type="hidden" name="name" value="@p.DisplayName" />
                            <input type="hidden" name="isActive" value="@((!p.IsActive).ToString().ToLowerInvariant())" />
                            <button class="vk-btn vk-btn-light vk-btn-sm" type="submit" title="@(p.IsActive ? "Stop them signing in" : "Let them sign in again")">
                                <i class="fa @(p.IsActive ? "fa-ban" : "fa-check")"></i> @(p.IsActive ? "Switch off" : "Switch on")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.People.Count == 0)
        {
            <tr><td colspan="8" class="vk-empty">Nobody here. Use Add people to invite your office.</td></tr>
        }
        </tbody>
    </table>
    </div>
</section>

<vk-dialog id="inviteDialog" title="Add a person" icon="user-plus" ok-text="Send invite" action="/team/invite" width="520px">
    @Html.AntiForgeryToken()
    <vk-input id="displayName" label="Name" icon="user-o" mandatory="true" placeholder="Meera Iyer" max-length="120" />
    <vk-input id="email" label="Work email" icon="envelope-o" mandatory="true" placeholder="meera@yourcompany.com" input-type="email" max-length="200" />
    <vk-select id="role" label="Role" icon="id-badge" options="Member|Member · uses the apps,TenantAdmin|Admin · can also add and manage people" selected="Member" />
    <div class="vk-form-2">
        <vk-input id="department" label="Department" icon="sitemap" placeholder="Sales" max-length="80" />
        <vk-input id="jobTitle" label="Job title" icon="briefcase" placeholder="Accountant" max-length="80" />
    </div>
    <vk-input id="joiningDate" label="Joining date" icon="calendar" input-type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <p class="vk-dialog-note"><i class="fa fa-envelope-o"></i> They'll get an email with a link to set their password. The link works once and lasts 7 days.</p>
</vk-dialog>

<vk-dialog id="personDialog" title="Edit person" icon="pencil" ok-text="Save" action="/team/details" width="520px">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" id="personId" />
    <p class="vk-dialog-note" id="personEmail"></p>
    <vk-input id="personName" name="displayName" label="Name" icon="user-o" mandatory="true" max-length="120" />
    <div class="vk-form-2">
        <vk-input id="personDept" name="department" label="Department" icon="sitemap" max-length="80" />
        <vk-input id="personJob" name="jobTitle" label="Job title" icon="briefcase" max-length="80" />
    </div>
    <vk-input id="personJoined" name="joiningDate" label="Joining date" icon="calendar" input-type="date" />
</vk-dialog>

@section Scripts {
    <script>
        // fill the Edit person window from the row and open it
        document.addEventListener("click", function (e) {
            var b = e.target.closest("[data-edit-person]"); if (!b) return;
            var d = b.dataset;
            document.getElementById("personId").value = d.id;
            document.getElementById("personEmail").textContent = d.email;
            document.getElementById("personName").value = d.name || "";
            document.getElementById("personDept").value = d.dept || "";
            document.getElementById("personJob").value = d.job || "";
            document.getElementById("personJoined").value = d.joined || "";
            document.getElementById("personDialog").showModal();
        });
    </script>
}

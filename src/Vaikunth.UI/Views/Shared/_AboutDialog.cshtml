@using System.Reflection
@using Microsoft.Extensions.Configuration
@using Vaikunth.ServiceLibrary
@inject CurrentApp Current
@inject IConfiguration Config
@* About Vaikunth Office: the same glass window on every page (launcher, People, Clients, the five apps, sign-in).
   Open it with any element that has data-open-dialog="aboutDialog". *@
@{
    var v = Assembly.GetEntryAssembly()?.GetName().Version;
    var version = v is null ? "1.0" : $"{v.Major}.{v.Minor}.{v.Build}";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var roleText = User.IsSuperAdmin() ? "Super admin" : User.IsInRole(AppRoles.TenantAdmin) ? "Client admin" : "Member";
    var data = ServiceRegistration.UsesMockData(Config) ? "Sample data (mock mode, no database)" : "SQL Server";
}
<dialog id="aboutDialog" class="vk-dialog vk-about-dialog" aria-labelledby="aboutTitle" style="width:min(620px, calc(100vw - 32px))">
    <div class="vk-dialog-inner">
        <div class="vk-about-head">
            <button type="button" class="vk-dialog-x" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
            <vk-app-icon app="suite" size="84" />
            <h2 id="aboutTitle" class="vk-about-title">VAIKUNTH OFFICE</h2>
            <div class="vk-muted">@SuiteApps.Suite.Tagline</div>
            <span class="vk-pill">Version @version</span>
        </div>
        <div class="vk-dialog-body vk-about-body">
            <div class="vk-about-apps">
                @foreach (var a in SuiteApps.All)
                {
                    <span class="@(!Current.IsSuite && a.App == Current.Info.App ? "on" : "")"><img src="@a.IconUrl" alt="" width="34" height="34" /><b>@a.Name</b><small>@a.Kind</small></span>
                }
            </div>
            @if (signedIn)
            {
                <div class="vk-kv"><span>Signed in as</span><b>@User.DisplayName() · @roleText</b></div>
                <div class="vk-kv"><span>Company</span><b>@(User.IsSuperAdmin() ? "All clients" : User.TenantName())</b></div>
            }
            <div class="vk-kv"><span>You are in</span><b>@Current.Info.Name</b></div>
            <div class="vk-kv"><span>Data</span><b>@data</b></div>
            <vk-verse variant="box" />
        </div>
        <div class="vk-dialog-foot">
            <span class="vk-muted vk-small">© @DateTime.UtcNow.Year Vaikunth Office</span>
            <span class="vk-fill"></span>
            <button type="button" class="vk-btn vk-btn-primary" data-close>Close</button>
        </div>
    </div>
</dialog>

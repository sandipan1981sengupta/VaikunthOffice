@* Profile photo and My account windows, and the toast: shared by the suite layout and the super admin layout. *@
    @* Profile photo: saved in the database with the person (Vaikunth_Users.Photo), shrunk to 256 × 256 in the browser first. *@
    @{ var photoError = TempData["PhotoError"] as string; var photoDone = TempData["PhotoDone"] as string; }
    <vk-dialog id="photoDialog" title="Profile photo" icon="camera" ok-text="Save photo" action="/account/photo" enctype="multipart/form-data" width="440px">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <div class="vk-photo-pick">
            <span class="vk-photo-preview" id="photoPreview">
                @if (User.PhotoUrl() is { } url) { <img src="@url" alt="" /> } else { <vk-avatar name="@User.DisplayName()" tone="@User.AvatarTone()" size="112" /> }
            </span>
            <label class="vk-btn vk-btn-light vk-photo-choose"><i class="fa fa-upload"></i> Choose a picture
                <input type="file" name="photo" id="photoFile" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
            </label>
            <p class="vk-dialog-note">PNG, JPEG or WebP. It is cropped to a square and made small before it is saved.</p>
            @if (photoError is not null) { <p class="vk-form-error" data-open-on-load>@photoError</p> }
            @if (User.PhotoUrl() is not null)
            {
                <button type="submit" class="vk-link-btn" formaction="/account/photo/remove" formnovalidate><i class="fa fa-trash-o"></i> Remove my photo</button>
            }
        </div>
    </vk-dialog>
    @* My account: change your own name, email and password (the current password is always needed). *@
    @{ var accountError = TempData["AccountError"] as string; var accountDone = TempData["AccountDone"] as string; }
    <vk-dialog id="accountDialog" title="My account" icon="user-circle-o" ok-text="Save changes" action="/account/me" width="480px">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        @if (accountError is not null) { <p class="vk-form-error" data-open-on-load>@accountError</p> }
        <vk-input id="acctName" name="displayName" label="Your name" icon="user-o" mandatory="true" value="@User.DisplayName()" />
        <vk-input id="acctEmail" name="email" label="Email (you sign in with this)" icon="envelope-o" mandatory="true" input-type="email" value="@User.Identity?.Name" autocomplete="username" />
        <div class="vk-account-pw">
            <vk-input id="acctNewPassword" name="newPassword" label="New password" is-password="true" placeholder="Optional" autocomplete="new-password" />
            <vk-input id="acctConfirmPassword" name="confirmPassword" label="New password again" is-password="true" autocomplete="new-password" />
        </div>
        <vk-input id="acctCurrentPassword" name="currentPassword" label="Current password" is-password="true" mandatory="true" placeholder="Needed to save any change" autocomplete="current-password" />
        <p class="vk-dialog-note"><i class="fa fa-shield"></i> @(User.IsSuperAdmin() ? "You are the super admin. Use an email you check: password reset links go there." : "Password reset links go to this email.")</p>
    </vk-dialog>
    <div class="vk-toast" id="toast" hidden></div>
    @if (accountDone is not null) { <script>document.addEventListener("DOMContentLoaded", function () { VK.toast(@Json.Serialize(accountDone)); });</script> }
    @if (photoDone is not null) { <script>document.addEventListener("DOMContentLoaded", function () { VK.toast(@Json.Serialize(photoDone)); });</script> }


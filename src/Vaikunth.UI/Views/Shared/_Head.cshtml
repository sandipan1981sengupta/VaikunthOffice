@inject CurrentApp Current
@* What every page of the suite loads first: fonts, icons and the suite styles. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="@Current.Info.IconUrl" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" />
@* one request for the icons and the suite styles (Infrastructure/Bundles.cs), cached by the browser *@
<vk-bundle name="site.css" />

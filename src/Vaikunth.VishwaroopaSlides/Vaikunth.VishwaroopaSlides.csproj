<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Vishwaroopa Slides (PowerPoint): its editor (controller, view, JS and CSS) as a library. It runs inside Vaikunth.Office.Web
       at /slides, in its own browser tab. Sign-in, launcher, tag helpers and layouts come from Vaikunth.UI;
       all data access is in Vaikunth.ServiceLibrary. Its wwwroot is served at /_content/Vaikunth.VishwaroopaSlides/... -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vaikunth.VishwaroopaSlides</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vaikunth.DtoLibrary\Vaikunth.DtoLibrary.csproj" />
    <ProjectReference Include="..\Vaikunth.ServiceLibrary\Vaikunth.ServiceLibrary.csproj" />
    <ProjectReference Include="..\Vaikunth.UI\Vaikunth.UI.csproj" />
  </ItemGroup>

</Project>

    // "Server=.;Database=VaikunthOffice;Trusted_Connection=True;TrustServerCertificate=True"
    "Default": ""
  },
  "Mock": { "Password": "vaikunth123" },
  "Suite": {
    "PagesUrl": "http://localhost:5101",
    "WorkbookUrl": "http://localhost:5102",
    "SlidesUrl": "http://localhost:5103",
    // The address people use, for links in emails. Empty = the address of the request.
    "PublicBaseUrl": "",
    // The three apps must share this folder so one sign-in works in all of them. Empty = the temp folder.
    "DataProtectionKeysPath": ""
  },
  // Where the Word, Excel and PowerPoint files are saved on the server. The database keeps only their name,
  // who created / updated them, the dates and whether they are deleted.
  // RootPath: your folder, e.g. "D:\\VaikunthFiles" or a share "\\\\fileserver\\VaikunthFiles".
  //           Empty = App_Data\\VaikunthFiles inside the folder where this app is hosted.
  //           If the three apps are hosted in different folders or servers, give all three the same folder.
  // MaxFileMb: largest file one save may be (pictures inside it count).
  "Storage": {
    "RootPath": "",
    "MaxFileMb": 200
  },
  // Email for welcome, invite and password-reset links. Leave Host empty to keep emails in the developer outbox
  // (/dev/outbox, Development only). Port 465 = SSL on connect; 587 = STARTTLS (Gmail, Office 365, Brevo).
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Vaikunth Office",
    "OutboxPath": ""
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}

<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: let a save carry a big file (pictures included). The app itself caps it at Storage:MaxFileMb in appsettings.json.
     420 MB here matches the default 200 MB file limit (sent as text, so about twice the size). -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="440401920" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

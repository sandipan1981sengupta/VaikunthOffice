<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Sudarshana Inbox (mail): folders, reading pane, compose, reply and forward. Mail between the company's people stays inside Vaikunth; other addresses get a real email. It runs inside Vaikunth.Office.Web at /inbox.
       Its wwwroot is served at /_content/Vaikunth.SudarshanaInbox/... and bundled as inbox.css / inbox.js. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vaikunth.SudarshanaInbox</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vaikunth.DtoLibrary\Vaikunth.DtoLibrary.csproj" />
    <ProjectReference Include="..\Vaikunth.ServiceLibrary\Vaikunth.ServiceLibrary.csproj" />
    <ProjectReference Include="..\Vaikunth.UI\Vaikunth.UI.csproj" />
  </ItemGroup>

</Project>

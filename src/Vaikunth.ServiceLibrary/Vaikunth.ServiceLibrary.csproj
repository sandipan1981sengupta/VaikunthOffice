<Project Sdk="Microsoft.NET.Sdk">

  <!-- All business functions of Vaikunth Office: sign-in checks and documents, as stored procedure calls.
       When ConnectionStrings:Default is empty the in-memory mock services are used instead (Mock folder). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vaikunth.ServiceLibrary</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Options, logging, configuration and the password hasher come from the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Plain ADO.NET for SQL Server / Azure SQL stored procedures. No Entity Framework. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <!-- Email over SMTP: port 465 (SSL on connect) and 587 (STARTTLS). -->
    <PackageReference Include="MailKit" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- sample PDF for Shashvata Reader in sample-data (mock) mode -->
    <EmbeddedResource Include="Mock\Samples\team-handbook.pdf" LogicalName="Vaikunth.Samples.team-handbook.pdf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vaikunth.DtoLibrary\Vaikunth.DtoLibrary.csproj" />
  </ItemGroup>

</Project>

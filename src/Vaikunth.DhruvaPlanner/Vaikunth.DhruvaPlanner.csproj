<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Dhruva Planner (projects): its planner (controller, view, JS and CSS) as a library. It runs inside Vaikunth.Office.Web
       at /planner, in its own browser tab. Board, list and timeline are drawn in the browser; Download makes an
       Excel file (ClosedXML) on the server. Its wwwroot is served at /_content/Vaikunth.DhruvaPlanner/... -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vaikunth.DhruvaPlanner</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vaikunth.DtoLibrary\Vaikunth.DtoLibrary.csproj" />
    <ProjectReference Include="..\Vaikunth.ServiceLibrary\Vaikunth.ServiceLibrary.csproj" />
    <ProjectReference Include="..\Vaikunth.UI\Vaikunth.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
